    <SolidColorBrush x:Key="CardHoverBrush" Color="#1C2026" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2A2F37" />
    <SolidColorBrush x:Key="BorderBrush" Color="#262B33" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#616A78" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1A1D22" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F2329" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A414C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A9B3" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#868D98" />
