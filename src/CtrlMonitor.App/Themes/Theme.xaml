    <SolidColorBrush x:Key="WarningSoftBrush" Color="#302712" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF4D6D" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1520" />
    <SolidColorBrush x:Key="DangerStrongBrush" Color="#C41F45" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

    <!-- Escala térmica: de frío a crítico. -->
    <SolidColorBrush x:Key="TempColdBrush" Color="#5AB8F5" />
