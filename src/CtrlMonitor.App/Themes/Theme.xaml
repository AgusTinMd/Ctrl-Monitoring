    <!-- Va acá y no en App.xaml: las plantillas de este diccionario no ven los
         recursos de App.xaml (por ejemplo, el pie de la barra lateral). -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ===================== Paleta: Térmica ===================== -->
    <!-- Grafito neutro: el color se reserva para lo que significa algo. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0F12" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#111317" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14171B" />
