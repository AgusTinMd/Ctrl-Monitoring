<Application x:Class="CtrlMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CtrlMonitor.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:IntEqualsConverter x:Key="IntEquals" />
            <converters:WidthToColumnsConverter x:Key="WidthToColumns" />
            <converters:ChartColumnsConverter x:Key="ChartColumns" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
