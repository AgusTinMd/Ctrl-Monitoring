<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CtrlMonitor</AssemblyName>
    <RootNamespace>CtrlMonitor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fan.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Versión fija para compilaciones locales: la real la pone el tag vX.Y.Z
         al publicar (build/package.ps1 pasa -p:Version). No hace falta tocarla. -->
    <Version>0.0.0</Version>
    <Product>Ctrl Monitor</Product>
    <Description>Monitor de temperaturas, ventiladores, memoria y red. Solo lectura.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CtrlMonitor.Core\CtrlMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\fan.ico" />
    <Resource Include="Assets\fan.png" />
    <Resource Include="Assets\asus.png" />
    <Resource Include="Assets\gigabyte.png" />
    <Resource Include="Assets\msi.png" />
    <Resource Include="Assets\asrock.png" />
    <Resource Include="Assets\intel.png" />
    <Resource Include="Assets\amd.png" />
    <Resource Include="Assets\wd.png" />
    <Resource Include="Assets\samsung.png" />
    <Resource Include="Assets\seagate.png" />
    <Resource Include="Assets\toshiba.png" />
    <Resource Include="Assets\sandisk.png" />
  </ItemGroup>

</Project>
