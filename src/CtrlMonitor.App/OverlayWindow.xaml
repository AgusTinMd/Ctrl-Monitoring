<Window x:Class="CtrlMonitor.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CtrlMonitor.App.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="Root"
          Background="Transparent"
          Cursor="SizeAll"
          MouseLeftButtonDown="OnRootMouseLeftButtonDown">
        <Border x:Name="EditBorder"
                BorderThickness="1"
                CornerRadius="{Binding OverlayEditCornerRadius}"
                Padding="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverlayEditing}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <controls:OverlayBar Visibility="{Binding IsBarMode, Converter={StaticResource BoolToVis}}" />
                <controls:BenchmarkPanel Visibility="{Binding IsBenchmarkMode, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
