<Window x:Class="CtrlMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CtrlMonitor.App.Controls"
        xmlns:l="clr-namespace:CtrlMonitor.App.Localization"
        xmlns:vm="clr-namespace:CtrlMonitor.App.ViewModels"
        Title="Ctrl Monitor"
        Width="1220" Height="820" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/fan.ico"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Plantillas explícitas en lugar de DisplayMemberPath: el estilo del
             ComboBox muestra la opción elegida con ItemTemplate, y así el texto
             también se actualiza al cambiar de idioma. -->
        <DataTemplate x:Key="MetricTitleTemplate">
            <TextBlock Text="{Binding Title}" />
        </DataTemplate>
        <DataTemplate x:Key="LanguageNameTemplate">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>

        <!-- Color del overlay: muestra la muestra de color junto al nombre. -->
        <DataTemplate x:Key="OverlayColorTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="13" Height="13" CornerRadius="3"
                        Background="{Binding Brush}"
                        BorderBrush="#33FFFFFF" BorderThickness="1"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Valores de una métrica (principal, secundario, terciario y cuarto);
             lo usan las tarjetas y el gráfico grande de la vista de lista. -->
        <DataTemplate x:Key="ChartValuesTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SecondaryLabel}" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,2,0,0">
                        <TextBlock Text="{Binding SecondaryInline}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,6,1" />
                        <TextBlock Text="{Binding SecondaryValue}"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{Binding SecondaryValueBrush}" />
                        <TextBlock Text="{Binding SecondaryUnit}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,-1,0,0"
                                Visibility="{Binding HasQuaternary, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding QuaternaryInline}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,6,1" />
                        <TextBlock Text="{Binding QuaternaryValue}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{Binding QuaternaryValueBrush}" />
                        <TextBlock Text="{Binding QuaternaryUnit}" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                </StackPanel>

                <Border Width="1" Height="34" Margin="0,0,12,0"
                        Background="{StaticResource BorderBrush}"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}" />

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PrimaryLabel}" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Right" Margin="0,0,0,2"
                               Visibility="{Binding HasPrimaryLabel, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PrimaryValue}"
                                   FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding PrimaryUnit}" Style="{StaticResource UnitText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,-2,0,0"
                                Visibility="{Binding HasTertiary, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TertiaryValue}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TertiaryUnit}" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Los mismos valores en columna, para la izquierda de las tarjetas. -->
        <DataTemplate x:Key="ChartValuesColumnTemplate">
            <StackPanel>
                <TextBlock Text="{Binding PrimaryLabel}" Style="{StaticResource CaptionText}"
                           Visibility="{Binding HasPrimaryLabel, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PrimaryValue}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PrimaryUnit}" Style="{StaticResource UnitText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,-2,0,0"
                            Visibility="{Binding HasTertiary, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding TertiaryValue}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TertiaryUnit}" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SecondaryLabel}" Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding SecondaryInline}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,5,1" />
                        <TextBlock Text="{Binding SecondaryValue}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding SecondaryValueBrush}" />
                        <TextBlock Text="{Binding SecondaryUnit}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasQuaternary, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding QuaternaryInline}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,5,1" />
                        <TextBlock Text="{Binding QuaternaryValue}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding QuaternaryValueBrush}" />
                        <TextBlock Text="{Binding QuaternaryUnit}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChartCardTemplate">
            <!-- Toda la tarjeta se puede arrastrar para reordenarla; el selector
                 y la ✕ manejan sus propios clics y no inician el arrastre. -->
            <Border Padding="16,12,14,10" Margin="5" MinHeight="250"
                    AllowDrop="True"
                    MouseLeftButtonDown="ChartCard_MouseLeftButtonDown"
                    MouseMove="ChartCard_MouseMove"
                    MouseLeftButtonUp="ChartCard_MouseLeftButtonUp"
                    LostMouseCapture="ChartCard_LostMouseCapture"
                    DragOver="ChartCard_DragOver"
                    Drop="ChartCard_Drop">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <!-- Clic sobre la tarjeta: se «levanta» con borde y sombra de acento. -->
                            <DataTrigger Binding="{Binding IsDragArmed}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3AD1C0" BlurRadius="22"
                                                          ShadowDepth="0" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <!-- Durante el arrastre la tarjeta real marca el hueco donde
                                 va a caer; la copia flotante sigue al cursor. -->
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Encabezado en una sola línea; los valores van a la izquierda del
                         gráfico para dejarle todo el alto al eje vertical. -->
                    <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="⠿" FontFamily="Segoe UI Symbol" FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="-4,0,6,0"
                                           Cursor="SizeAll"
                                           ToolTip="{l:Tr chart.dragTooltip}" />
                                <Ellipse Width="9" Height="9" Fill="{Binding Color}"
                                         VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding SelectedMetric, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource MetricTitleTemplate}"
                                          Width="110" Height="26" MinWidth="0" FontSize="11.5"
                                          Margin="9,0,0,0"
                                          ToolTip="{l:Tr chart.metricTooltip}" />
                                <Button Content="✕" Style="{StaticResource GhostButton}"
                                        Width="24" Height="24" Padding="0" FontSize="11"
                                        Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveChartPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{l:Tr chart.removeTooltip}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Content="{Binding}" Focusable="False"
                                        ContentTemplate="{StaticResource ChartValuesColumnTemplate}"
                                        VerticalAlignment="Top" Margin="0,10,6,0" />

                    <controls:LiveChart Grid.Column="1"
                                        Samples="{Binding DataContext.ChartSamples, RelativeSource={RelativeSource AncestorType=Window}}"
                                        WindowMinutes="{Binding DataContext.ChartWindowMinutes, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Series="{Binding SeriesKey}"
                                        Unit="{Binding AxisUnit}"
                                        AxisMin="{Binding AxisMin}"
                                        AxisMax="{Binding AxisMax}"
                                        AxisStep="{Binding AxisStep}"
                                        AutoScale="True">
                        <controls:LiveChart.Style>
                            <Style TargetType="controls:LiveChart">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThreads}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:LiveChart.Style>
                    </controls:LiveChart>
                    <ScrollViewer Grid.Column="1" Margin="0,10,0,0" MaxHeight="200" VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="ItemsSource"
                                        Value="{Binding DataContext.CpuThreads, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThreads}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCores}" Value="True">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.CpuCores, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ResponsiveGrid MinItemWidth="118" MaxColumns="8" Gap="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7" Padding="8,5"
                                        ToolTip="{Binding Tooltip}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding LoadText}" HorizontalAlignment="Right" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                        <controls:Sparkline Height="24" Margin="0,4,0,0"
                                                            FirstValues="{Binding History}"
                                                            FirstBrush="{StaticResource ChartCpuBrush}"
                                                            Capacity="60" MinimumScale="100" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Vista de lista (estilo Administrador de tareas): cada entrada tiene
             un mini gráfico, el nombre de la métrica y un resumen de valores. -->
        <Style x:Key="ChartListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChartListItemTemplate">
            <!-- Se arrastra para ordenar la lista, con los mismos manejadores que las tarjetas. -->
            <Grid Background="Transparent" AllowDrop="True"
                  ToolTip="{l:Tr chart.listDragTooltip}"
                  MouseLeftButtonDown="ChartCard_MouseLeftButtonDown"
                  MouseMove="ChartCard_MouseMove"
                  MouseLeftButtonUp="ChartCard_MouseLeftButtonUp"
                  LostMouseCapture="ChartCard_LostMouseCapture"
                  DragOver="ChartCard_DragOver"
                  Drop="ChartCard_Drop">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="78" Height="50" BorderThickness="1" CornerRadius="3"
                        BorderBrush="{Binding Color}" Background="{StaticResource SurfaceBrush}">
                    <controls:LiveChart Compact="True" IsHitTestVisible="False"
                                        Samples="{Binding DataContext.ChartSamples, RelativeSource={RelativeSource AncestorType=Window}}"
                                        WindowMinutes="{Binding DataContext.ChartWindowMinutes, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Series="{Binding SeriesKey}"
                                        AxisMin="{Binding AxisMin}"
                                        AxisMax="{Binding AxisMax}"
                                        AxisStep="{Binding AxisStep}"
                                        AutoScale="True" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedMetric.Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <TabControl Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" TabStripPlacement="Left">

        <!-- ============================================================ -->
        <!-- Resumen                                                      -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.summary}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.summary}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr summary.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <controls:ResponsiveGrid Margin="0,22,0,0" MinItemWidth="205" MaxColumns="4" Gap="12"
                                            BalancedRows="True">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CpuIconGeometry}" Fill="{StaticResource ChartCpuBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.cpuTemp}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding CpuTemperature, StringFormat={}{0:0}, TargetNullValue=—}" />
                                    <TextBlock Text="°C" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding CpuMaxText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GpuIconGeometry}" Fill="{StaticResource ChartGpuBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.gpuTemp}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding GpuTemperature, StringFormat={}{0:0}, TargetNullValue=—}" />
                                    <TextBlock Text="°C" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding GpuHotspotText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CpuIconGeometry}" Fill="{StaticResource ChartCpuBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.cpuPower}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding CpuPower, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                    <TextBlock Text="W" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding CpuLoadText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Margin="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GpuIconGeometry}" Fill="{StaticResource ChartGpuBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.gpuPower}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding GpuPower, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                    <TextBlock Text="W" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding GpuLoadText}" />
                            </StackPanel>
                        </Border>
                    </controls:ResponsiveGrid>

                    <!-- CPU y GPU -->
                    <controls:ResponsiveGrid Margin="0,16,0,0" MinItemWidth="380" MaxColumns="2" Gap="16">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="2" Source="{Binding CpuLogoUri}" Height="18" Opacity="0.9"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasCpuLogo, Converter={StaticResource BoolToVis}}" />
                                    <Border Style="{StaticResource IconBadge}">
                                        <Path Data="{StaticResource CpuIconGeometry}" Fill="{StaticResource ChartCpuBrush}"
                                              Width="21" Height="21" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:Tr hw.cpu}" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                    Background="{StaticResource AccentSoftBrush}" Padding="9,3">
                                                <TextBlock Text="CPU" Foreground="{StaticResource AccentTextBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:Tr summary.temperature}" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SensorValueText}">
                                        <Run Text="{Binding CpuTemperature, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="1" Text="{l:Tr summary.coreMax}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding CpuMaxTemperature, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Text="{l:Tr summary.power}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding CpuPower, Mode=OneWay, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                        <Run Text=" W" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="3" Text="{l:Tr summary.fan}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding CpuFanRpm, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" RPM" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="4" Text="RAM" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0"
                                               Text="{Binding RamUsageText}"
                                               ToolTip="{Binding RamUsageText}" />
                                </Grid>

                                <!-- Carga de cada hilo, al estilo btop: una fila por hilo con su número,
                                     barra y porcentaje. Las columnas se acomodan al ancho, así que
                                     procesadores con muchos hilos suman filas en lugar de achicarlas. -->
                                <StackPanel Margin="0,14,0,0"
                                            Visibility="{Binding HasCpuThreads, Converter={StaticResource BoolToVis}}">
                                    <ToggleButton IsChecked="{Binding CpuThreadsExpanded, Mode=TwoWay}"
                                                  Background="Transparent" BorderThickness="0" Padding="0"
                                                  HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                  FocusVisualStyle="{x:Null}"
                                                  ToolTip="{l:Tr summary.threadsToggle}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Grid>
                                            <TextBlock Text="{Binding CpuThreadsTitle}" Style="{StaticResource SecondaryText}" />
                                            <Path Width="9" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M 1,1 L 5,5 L 9,1" RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CpuThreadsExpanded}" Value="False">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </ToggleButton>
                                    <ItemsControl ItemsSource="{Binding CpuThreads}" Margin="0,8,0,0" Focusable="False"
                                                  Visibility="{Binding CpuThreadsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ResponsiveGrid MinItemWidth="112" MaxColumns="4" Gap="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource MeterBar}"
                                                                 Minimum="0" Maximum="100" Height="6"
                                                                 Value="{Binding Load, Mode=OneWay}"
                                                                 Foreground="{StaticResource ChartCpuBrush}"
                                                                 VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding LoadText}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Typography.NumeralAlignment="Tabular"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="2" Source="{Binding GpuLogoUri}" Height="18" Opacity="0.9"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasGpuLogo, Converter={StaticResource BoolToVis}}" />
                                    <Border Style="{StaticResource IconBadge}">
                                        <Path Data="{StaticResource GpuIconGeometry}" Fill="{StaticResource ChartGpuBrush}"
                                              Width="21" Height="21" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:Tr hw.gpu}" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                    Background="{StaticResource AccentSoftBrush}" Padding="9,3">
                                                <TextBlock Text="GPU" Foreground="{StaticResource AccentTextBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:Tr summary.temperature}" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SensorValueText}">
                                        <Run Text="{Binding GpuTemperature, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="1" Text="Hotspot" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding GpuHotspot, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Text="{l:Tr summary.power}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding GpuPower, Mode=OneWay, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                        <Run Text=" W" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="3" Text="{l:Tr summary.fan}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding GpuFanRpm, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" RPM" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="4" Text="VRAM" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0"
                                               Text="{Binding VramText}"
                                               ToolTip="{Binding VramText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </controls:ResponsiveGrid>

                    <!-- Placa madre -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}" Width="30" Height="30">
                                    <Path Data="{StaticResource BoardIconGeometry}"
                                          Fill="{StaticResource ChartBoardBrush}"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{l:Tr summary.boardCaption}" Style="{StaticResource CaptionText}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding MotherboardName}" Style="{StaticResource SectionTitle}"
                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Almacenamiento: espacio usado y libre de cada unidad -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}" Width="30" Height="30">
                                    <Path Data="{StaticResource DiskIconGeometry}"
                                          Fill="{StaticResource AccentBrush}"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{l:Tr storage.title}" Style="{StaticResource CaptionText}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{l:Tr storage.loading}" Margin="0,12,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVolumes}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Un bloque por disco físico: salud, temperatura y desgaste
                                 arriba, y sus unidades con el espacio debajo. -->
                            <ItemsControl ItemsSource="{Binding StorageDisks}" Margin="0,14,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveGrid MinItemWidth="260" MaxColumns="3" Gap="24" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TemperatureText}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{Binding TemperatureBrush}" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVis}}" />
                                                    <Border Style="{StaticResource Chip}" Padding="8,3"
                                                            ToolTip="{l:Tr storage.healthTooltip}"
                                                            Visibility="{Binding HasHealth, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding HealthBrush}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding HealthText}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding HealthBrush}" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Detalle en un renglón y vida siempre presente (vacía en
                                                 discos sin ese dato): así las unidades de todos los discos
                                                 empiezan a la misma altura. -->
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Detail}" />
                                            <TextBlock Text="{Binding LifeText}" Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0" TextWrapping="NoWrap" />

                                            <!-- Lectura y escritura en vivo con un mini gráfico. -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource ChartDiskReadBrush}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ReadText}" Style="{StaticResource SecondaryText}"
                                                               Margin="6,0,14,0" TextWrapping="NoWrap" />
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource ChartDiskWriteBrush}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding WriteText}" Style="{StaticResource SecondaryText}"
                                                               Margin="6,0,0,0" TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <controls:Sparkline Height="30" Margin="0,6,0,0"
                                                                    FirstValues="{Binding ReadValues}"
                                                                    SecondValues="{Binding WriteValues}"
                                                                    FirstBrush="{StaticResource ChartDiskReadBrush}"
                                                                    SecondBrush="{StaticResource ChartDiskWriteBrush}"
                                                                    Capacity="40" MinimumScale="1" />
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,12,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Letter}" FontSize="13.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"
                                                                           Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <ProgressBar Style="{StaticResource MeterBar}" Minimum="0" Maximum="100"
                                                                         Value="{Binding UsedPercent, Mode=OneWay}"
                                                                         Foreground="{Binding BarBrush}" Margin="0,7,0,0" />
                                                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource SecondaryText}"
                                                                       Margin="0,6,0,0" />
                                                            <TextBlock Text="{Binding UsedText}" Style="{StaticResource MutedText}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Gráfico                                                      -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.chart}" Style="{StaticResource NavTabItem}">
            <ScrollViewer x:Name="ChartScroll" Margin="24,20,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ChartRoot"
                      MinHeight="{Binding ViewportHeight, ElementName=ChartScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr chart.title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{l:Tr chart.subtitle}"
                                   Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,12,0,0">
                        <!-- Vista de la sección: tarjetas o lista con gráfico grande. -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{l:Tr chart.view.cards}" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartView"
                                             IsChecked="{Binding IsChartCardView, Mode=TwoWay}" />
                                <RadioButton Content="{l:Tr chart.view.list}" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartView"
                                             IsChecked="{Binding IsChartListView, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="1 min" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartWindow"
                                             IsChecked="{Binding ChartWindowMinutes, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                                <RadioButton Content="5 min" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartWindow"
                                             IsChecked="{Binding ChartWindowMinutes, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=5}" />
                                <RadioButton Content="10 min" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartWindow"
                                             IsChecked="{Binding ChartWindowMinutes, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=10}" />
                            </StackPanel>
                        </Border>

                        <Button Content="{l:Tr chart.clear}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearChartCommand}" />

                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                    Visibility="{Binding CanAddChartPanel, Converter={StaticResource BoolToVis}}">
                            <ComboBox Width="140" Height="34" MinWidth="0"
                                      ItemsSource="{Binding AvailableChartMetrics}"
                                      SelectedItem="{Binding NewChartMetric, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource MetricTitleTemplate}"
                                      ToolTip="{l:Tr chart.addTooltip}" />
                            <Button Content="{l:Tr chart.add}" Style="{StaticResource AccentButton}"
                                    Command="{Binding AddChartPanelCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Margin="0,14,0,0"
                           Text="{l:Tr chart.hint}"
                           Style="{StaticResource MutedText}"
                           Visibility="{Binding IsChartCardView, Converter={StaticResource BoolToVis}}" />

                <ItemsControl Grid.Row="2" Margin="-5,2,-5,-5"
                              Visibility="{Binding IsChartCardView, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ChartPanels}"
                              ItemTemplate="{StaticResource ChartCardTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid>
                                <UniformGrid.Columns>
                                    <MultiBinding Converter="{StaticResource ChartColumns}">
                                        <Binding Path="ViewportWidth" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                        <Binding Path="ViewportHeight" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                    </MultiBinding>
                                </UniformGrid.Columns>
                            </UniformGrid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Grid.Row="2" Margin="0,40,0,0"
                           Text="{l:Tr chart.empty}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Visibility="{Binding ShowChartPanelsEmpty, Converter={StaticResource BoolToVis}}" />

                <!-- Vista de lista: métricas a la izquierda y la elegida en grande. -->
                <!-- Alto fijo al visible: la lista tiene su propio scroll y el
                     gráfico grande ocupa la pantalla, como en el Administrador de tareas. -->
                <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,16,0,0" VerticalAlignment="Top"
                      Height="{Binding ViewportHeight, ElementName=ChartScroll, Converter={StaticResource Subtract}, ConverterParameter=110}"
                      Visibility="{Binding IsChartListView, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox ItemsSource="{Binding ChartListItems}"
                             SelectedItem="{Binding SelectedChartListItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ChartListItem}"
                             ItemTemplate="{StaticResource ChartListItemTemplate}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0"
                            DataContext="{Binding SelectedChartListItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedMetric.Title}" FontSize="24"
                                                   FontWeight="SemiBold" Margin="10,0,0,0"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                               Margin="20,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ContentControl Grid.Column="1" Content="{Binding}" Focusable="False"
                                                ContentTemplate="{StaticResource ChartValuesTemplate}"
                                                VerticalAlignment="Center" />
                            </Grid>

                            <controls:LiveChart Grid.Row="1" Margin="0,12,0,0" MinHeight="260"
                                                Samples="{Binding DataContext.ChartSamples, RelativeSource={RelativeSource AncestorType=Window}}"
                                                WindowMinutes="{Binding DataContext.ChartWindowMinutes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Series="{Binding SeriesKey}"
                                                Unit="{Binding AxisUnit}"
                                                AxisMin="{Binding AxisMin}"
                                                AxisMax="{Binding AxisMax}"
                                                AxisStep="{Binding AxisStep}"
                                                AutoScale="True">
                        <controls:LiveChart.Style>
                            <Style TargetType="controls:LiveChart">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThreads}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:LiveChart.Style>
                            </controls:LiveChart>
                            <ItemsControl Focusable="False" Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Top">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="ItemsSource"
                                        Value="{Binding DataContext.CpuThreads, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThreads}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCores}" Value="True">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.CpuCores, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ResponsiveGrid MinItemWidth="118" MaxColumns="8" Gap="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7" Padding="8,5"
                                        ToolTip="{Binding Tooltip}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding LoadText}" HorizontalAlignment="Right" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                        <controls:Sparkline Height="24" Margin="0,4,0,0"
                                                            FirstValues="{Binding History}"
                                                            FirstBrush="{StaticResource ChartCpuBrush}"
                                                            Capacity="60" MinimumScale="100" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Ventiladores                                                 -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.fans}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FansRoot" Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.fans}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr fans.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FanIconGeometry}" Fill="{StaticResource AccentBrush}"
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FanSummaryText}" Style="{StaticResource SecondaryText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="{l:Tr fans.onlyActive}" Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowOnlyActiveFans, Mode=TwoWay}"
                                      ToolTip="{l:Tr fans.onlyActiveTooltip}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding VisibleFans}" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource WidthToColumns}, ConverterParameter='760:1,1200:2,3'}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource IconBadge}" Width="34" Height="34">
                                                <Path Data="{StaticResource FanIconGeometry}" Fill="{StaticResource AccentBrush}"
                                                      Width="19" Height="19" Stretch="Uniform" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ChannelText}"
                                                               Style="{StaticResource SectionTitle}" />
                                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="7,2"
                                                            Background="{StaticResource SurfaceBrush}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RpmText}" FontSize="23" FontWeight="SemiBold"
                                                           Foreground="{Binding RpmBrush}" />
                                                <TextBlock Text="RPM" Style="{StaticResource UnitText}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <TextBlock Text="{l:Tr fans.pwmByBios}"
                                                       Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding PwmText}" HorizontalAlignment="Right"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>
                                        <ProgressBar Style="{StaticResource MeterBar}" Minimum="0" Maximum="100"
                                                     Value="{Binding PwmPercent}" Margin="0,6,0,0"
                                                     Visibility="{Binding HasPwm, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{l:Tr fans.noPwm}"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPwm}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,10,0,0"
                            Visibility="{Binding ShowActiveFilterEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{l:Tr fans.noneSpinning}"
                                   Style="{StaticResource SecondaryText}" />
                    </Border>

                    <TextBlock Text="{l:Tr fans.noChannelsHint}"
                               Style="{StaticResource MutedText}" Margin="6,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Sensores                                                     -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.sensors}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.sensors}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr sensors.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Background="Transparent" BorderThickness="0" Padding="0"
                                                      HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                      FocusVisualStyle="{x:Null}"
                                                      ToolTip="{l:Tr sensors.toggleTooltip}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource IconBadge}" Width="32" Height="32">
                                                    <Path Width="19" Height="19" Stretch="Uniform">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource CpuIconGeometry}" />
                                                                <Setter Property="Fill" Value="{StaticResource ChartCpuBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IconKey}" Value="Gpu">
                                                                        <Setter Property="Data" Value="{StaticResource GpuIconGeometry}" />
                                                                        <Setter Property="Fill" Value="{StaticResource ChartGpuBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKey}" Value="Board">
                                                                        <Setter Property="Data" Value="{StaticResource BoardIconGeometry}" />
                                                                        <Setter Property="Fill" Value="{StaticResource ChartBoardBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKey}" Value="Disk">
                                                                        <Setter Property="Data" Value="{StaticResource DiskIconGeometry}" />
                                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource CaptionText}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource MutedText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />

                                                <Path Grid.Column="3" Width="9" Height="6" Margin="12,0,0,0"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource TextMutedBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 1,1 L 5,5 L 9,1"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="180" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </ToggleButton>

                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,7,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource SecondaryText}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        HorizontalAlignment="Right" Margin="16,0,0,0">
                                                                <TextBlock Text="{Binding ValueText}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{Binding ValueBrush}" />
                                                                <TextBlock Text="{Binding UnitText}"
                                                                           Style="{StaticResource MutedText}"
                                                                           Margin="5,0,0,2" VerticalAlignment="Bottom" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource MeterBar}"
                                                                     Minimum="0" Maximum="100"
                                                                     Value="{Binding Percent}"
                                                                     Margin="0,5,0,0"
                                                                     Visibility="{Binding ShowsBar, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Discos                                                       -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.disks}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr disks.title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr disks.subtitle}" Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="{l:Tr disks.empty}" Margin="0,18,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiskDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding DiskDetails}" Margin="0,18,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- Encabezado: disco, modelo, estado y temperatura. Al hacer clic
                                             se despliega o contrae la ficha. -->
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Background="Transparent" BorderThickness="0" Padding="0"
                                                      HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                      FocusVisualStyle="{x:Null}" ToolTip="{l:Tr disks.toggleTooltip}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource IconBadge}" Background="{Binding ConditionSoftBrush}"
                                                        ToolTip="{Binding Subtitle}">
                                                    <Path Fill="{Binding ConditionBrush}" Width="22" Height="22" Stretch="Uniform">
                                                        <Path.Style>
                                                            <!-- Ícono según el tipo: HDD, SSD SATA o NVMe. -->
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource HddIconGeometry}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="SataSsd">
                                                                        <Setter Property="Data" Value="{StaticResource SataSsdIconGeometry}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="NvmeSsd">
                                                                        <Setter Property="Data" Value="{StaticResource NvmeSsdIconGeometry}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                                        <TextBlock Text="{Binding Model}" Style="{StaticResource SecondaryText}"
                                                                   Margin="10,0,0,0" VerticalAlignment="Bottom"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                                               Margin="0,3,0,0" />
                                                    <!-- Contraída: % usado y libre de todas sus unidades. -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsExpanded}" Value="False" />
                                                                            <Condition Binding="{Binding HasSpaceSummary}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <ProgressBar Style="{StaticResource MeterBar}" Width="120" Minimum="0" Maximum="100"
                                                                     Value="{Binding SpaceUsedPercentValue, Mode=OneWay}"
                                                                     Foreground="{Binding SpaceBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SpaceSummary}" Style="{StaticResource SecondaryText}"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding LogoUri, TargetNullValue={x:Null}}" Height="18" Opacity="0.9"
                                                           Margin="0,0,18,0" VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
                                                    <Border Style="{StaticResource BrandBadge}" Margin="0,0,18,0" VerticalAlignment="Center"
                                                            Visibility="{Binding HasBrandText, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding BrandText}" Style="{StaticResource BrandBadgeText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TemperatureText}" FontSize="19" FontWeight="SemiBold"
                                                               Foreground="{Binding TemperatureBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                                    <Border Style="{StaticResource Chip}" Background="{Binding ConditionSoftBrush}"
                                                            Padding="11,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding ConditionBrush}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ConditionText}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding ConditionBrush}" Margin="7,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Path Grid.Column="3" Width="9" Height="6" Margin="16,0,0,0"
                                                      Stretch="Uniform" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 1,1 L 5,5 L 9,1" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="180" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </ToggleButton>

                                        <!-- Contenido de la ficha: se oculta al contraerla. -->
                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <!-- Motivos cuando el estado no es «Bueno» -->
                                            <Border Margin="0,14,0,0" Padding="12,9" CornerRadius="8"
                                                    Background="{Binding ConditionSoftBrush}"
                                                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{l:Tr disks.issuesTitle}" Style="{StaticResource CaptionText}" />
                                                    <ItemsControl ItemsSource="{Binding Issues}" Focusable="False" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource SecondaryText}"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Datos S.M.A.R.T. principales -->
                                            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,16,0,0" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:ResponsiveGrid MinItemWidth="180" MaxColumns="4" Gap="18" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,12">
                                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" />
                                                            <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold"
                                                                       Foreground="{Binding ValueBrush}" Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}"
                                                                       Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Espacio: un anillo por unidad con el % usado -->
                                            <StackPanel Margin="0,6,0,14"
                                                        Visibility="{Binding HasVolumes, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:Tr disks.space}" Style="{StaticResource CaptionText}" />
                                                <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False" Margin="0,8,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,32,8">
                                                                <controls:DonutChart Width="84" Height="84" Thickness="11"
                                                                                     Value="{Binding UsedPercent}"
                                                                                     Fill="{Binding BarBrush}"
                                                                                     Track="{StaticResource TrackBrush}"
                                                                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Letter}" FontSize="15" FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"
                                                                                   Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource SecondaryText}"
                                                                               Margin="0,6,0,0" />
                                                                    <TextBlock Text="{Binding UsedText}" Style="{StaticResource MutedText}"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Tabla completa de atributos, plegada -->
                                            <Expander Header="{Binding AttributesHeader}" Margin="0,4,0,0"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      Visibility="{Binding HasAttributes, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Margin="0,10,0,0">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="150" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{l:Tr disks.column.id}" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Grid.Column="1" Text="{l:Tr disks.column.name}" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Grid.Column="2" Text="{l:Tr disks.column.current}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{l:Tr disks.column.worst}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{l:Tr disks.column.threshold}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="5" Text="{l:Tr disks.column.raw}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Attributes}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="44" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="64" />
                                                                        <ColumnDefinition Width="64" />
                                                                        <ColumnDefinition Width="64" />
                                                                        <ColumnDefinition Width="150" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource SecondaryText}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Current}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Worst}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding Threshold}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="5" Text="{Binding Raw}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Procesos                                                     -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.processes}" Style="{StaticResource NavTabItem}">
            <TabItem.Resources>
                <!-- Fila de un programa o proceso: nombre y celdas con calor, como el
                     Administrador de tareas. Las celdas ocupan todo el alto de la fila. -->
                <DataTemplate x:Key="ProcessCells">
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="{Binding DataContext.Processes.CpuWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                            <ColumnDefinition Width="{Binding DataContext.Processes.MemoryWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                            <ColumnDefinition Width="{Binding DataContext.Processes.DiskWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                            <ColumnDefinition Width="{Binding DataContext.Processes.NetworkWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                        </Grid.ColumnDefinitions>
                        <!-- Nombre recortable: ícono fijo y el texto se corta con «…» al achicar la columna. -->
                        <DockPanel Margin="{Binding NameIndent}" VerticalAlignment="Center" LastChildFill="True"
                                   ToolTip="{Binding Details}">
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,9,0"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                            <TextBlock DockPanel.Dock="Right" Text=" 🔒" FontSize="11" VerticalAlignment="Center"
                                       ToolTip="{l:Tr processes.protectedTooltip}"
                                       Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" />
                            <TextBlock FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="{Binding Description, Mode=OneWay}" /><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <Border Grid.Column="1" Background="{Binding CpuHeat}" Padding="8,0">
                    <TextBlock Text="{Binding CpuText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                        <Border Grid.Column="2" Background="{Binding MemoryHeat}" Padding="8,0">
                    <TextBlock Text="{Binding MemoryText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                        <Border Grid.Column="3" Background="{Binding DiskHeat}" Padding="8,0">
                    <TextBlock Text="{Binding DiskText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                        <Border Grid.Column="4" Background="{Binding NetworkHeat}" Padding="8,0">
                    <TextBlock Text="{Binding NetworkText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                    </Grid>
                </DataTemplate>

                <!-- Borde arrastrable de una columna: línea tenue que se marca al pasar el mouse. -->
                <ControlTemplate x:Key="ColumnResizeThumb" TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Line" Width="1" HorizontalAlignment="Left" Margin="1,6"
                                Background="{StaticResource BorderBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <!-- Programa: flecha para desplegar (si tiene varios procesos) y cantidad. -->
                <HierarchicalDataTemplate DataType="{x:Type vm:ProcessGroup}" ItemsSource="{Binding ChildrenView}">
                    <Grid>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProcessCells}" Margin="22,0,0,0" />
                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Width="22" Height="30"
                                      HorizontalAlignment="Left" Cursor="Hand" Focusable="False"
                                      ToolTip="{l:Tr processes.expandTooltip}"
                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource TextMutedBrush}"
                                              StrokeThickness="1.6" Width="6" Height="10" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </HierarchicalDataTemplate>

                <!-- Proceso de un programa, sangrado bajo su programa. -->
                <DataTemplate DataType="{x:Type vm:ProcessLeaf}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProcessCells}" Margin="22,0,0,0" />
                </DataTemplate>

                <!-- Filas sin la sangría ni el aspecto del TreeView de Windows. -->
                <Style x:Key="ProcessTreeItem" TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <StackPanel>
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Margin="0,0,0,1">
                                        <ContentPresenter ContentSource="Header" />
                                    </Border>
                                    <ItemsPresenter x:Name="Children" Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="Children" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabItem.Resources>

            <!-- Sin ScrollViewer de página: la lista tiene su propio scroll. -->
            <Grid Margin="24,16,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Con la navegación oculta, el título pasa a la barra superior. -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNavigation}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{l:Tr processes.title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr processes.subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <!-- Búsqueda, resumen y acciones -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="360" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="{l:Tr processes.search}"
                             Text="{Binding Processes.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- El resumen y el resultado de la última acción van junto a los
                         botones: así no ocupan una fila debajo de la lista. -->
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Processes.Summary}" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <!-- Sin resultado que mostrar no ocupa lugar: el resumen queda centrado. -->
                        <TextBlock Text="{Binding Processes.Status}"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="11"
                                   Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{l:Tr processes.endTree}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding Processes.EndTreeCommand}" Margin="0,0,10,0"
                                ToolTip="{l:Tr processes.endTreeTooltip}" />
                        <Button Content="{l:Tr processes.endTask}" Style="{StaticResource DangerButton}"
                                Command="{Binding Processes.EndTaskCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Tabla -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,6,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Encabezados: total del equipo arriba y nombre de la columna abajo. -->
                        <Grid Margin="0,0,18,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="{Binding DataContext.Processes.CpuWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                                <ColumnDefinition Width="{Binding DataContext.Processes.MemoryWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                                <ColumnDefinition Width="{Binding DataContext.Processes.DiskWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                                <ColumnDefinition Width="{Binding DataContext.Processes.NetworkWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" MinWidth="56" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Padding="30,4,8,4"
                                    HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Bottom"
                                    Command="{Binding Processes.SortByCommand}" CommandParameter="Name">
                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Bottom">
                                    <Run Text="{l:Tr processes.column.name}" /><Run Text="{Binding Processes.NameArrow, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                            <!-- Separadores para cambiar el ancho de cada columna. -->
                            <Thumb Grid.Column="1" Width="7" HorizontalAlignment="Left" Panel.ZIndex="1"
                                   Tag="Cpu" DragDelta="ProcessColumnThumb_DragDelta"
                                   Cursor="SizeWE" Focusable="False" ToolTip="{l:Tr processes.resizeTooltip}"
                                   Template="{StaticResource ColumnResizeThumb}" />
                            <Thumb Grid.Column="2" Width="7" HorizontalAlignment="Left" Panel.ZIndex="1"
                                   Tag="Memory" DragDelta="ProcessColumnThumb_DragDelta"
                                   Cursor="SizeWE" Focusable="False" ToolTip="{l:Tr processes.resizeTooltip}"
                                   Template="{StaticResource ColumnResizeThumb}" />
                            <Thumb Grid.Column="3" Width="7" HorizontalAlignment="Left" Panel.ZIndex="1"
                                   Tag="Disk" DragDelta="ProcessColumnThumb_DragDelta"
                                   Cursor="SizeWE" Focusable="False" ToolTip="{l:Tr processes.resizeTooltip}"
                                   Template="{StaticResource ColumnResizeThumb}" />
                            <Thumb Grid.Column="4" Width="7" HorizontalAlignment="Left" Panel.ZIndex="1"
                                   Tag="Network" DragDelta="ProcessColumnThumb_DragDelta"
                                   Cursor="SizeWE" Focusable="False" ToolTip="{l:Tr processes.resizeTooltip}"
                                   Template="{StaticResource ColumnResizeThumb}" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="8,4"
                                    HorizontalContentAlignment="Right" HorizontalAlignment="Stretch"
                                    Command="{Binding Processes.SortByCommand}" CommandParameter="Cpu">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Processes.CpuTotal}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right">
                                        <Run Text="{l:Tr processes.column.cpu}" /><Run Text="{Binding Processes.CpuArrow, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="8,4"
                                    HorizontalContentAlignment="Right" HorizontalAlignment="Stretch"
                                    Command="{Binding Processes.SortByCommand}" CommandParameter="Memory">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Processes.MemoryTotal}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right">
                                        <Run Text="{l:Tr processes.column.memory}" /><Run Text="{Binding Processes.MemoryArrow, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="8,4"
                                    HorizontalContentAlignment="Right" HorizontalAlignment="Stretch"
                                    Command="{Binding Processes.SortByCommand}" CommandParameter="Disk">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Processes.DiskTotal}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right">
                                        <Run Text="{l:Tr processes.column.disk}" /><Run Text="{Binding Processes.DiskArrow, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="8,4"
                                    HorizontalContentAlignment="Right" HorizontalAlignment="Stretch"
                                    Command="{Binding Processes.SortByCommand}" CommandParameter="Network">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Processes.NetworkTotal}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right">
                                        <Run Text="{l:Tr processes.column.network}" /><Run Text="{Binding Processes.NetworkArrow, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TreeView Grid.Row="1" ItemsSource="{Binding Processes.View}"
                                  ItemContainerStyle="{StaticResource ProcessTreeItem}"
                                  SelectedItemChanged="ProcessTree_SelectedItemChanged"
                                  PreviewMouseRightButtonDown="ProcessTree_PreviewMouseRightButtonDown"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <!-- Clic derecho sobre una fila, como en el Administrador de tareas. -->
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding Processes.ExpandMenuText}" FontWeight="SemiBold"
                                              Command="{Binding Processes.ToggleExpandCommand}" />
                                    <MenuItem Header="{l:Tr processes.endTask}" Command="{Binding Processes.EndTaskCommand}" />
                                    <MenuItem Header="{l:Tr processes.menu.endTree}" Command="{Binding Processes.EndTreeCommand}" />
                                    <Separator Margin="4,3" Background="{StaticResource BorderBrush}" />
                                    <MenuItem Header="{l:Tr processes.menu.openLocation}" Command="{Binding Processes.OpenFileLocationCommand}" />
                                    <MenuItem Header="{l:Tr processes.menu.searchOnline}" Command="{Binding Processes.SearchOnlineCommand}" />
                                    <MenuItem Header="{l:Tr processes.menu.properties}" Command="{Binding Processes.ShowPropertiesCommand}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Resources>
                                <!-- Los procesos dentro de un programa usan el mismo estilo de fila. -->
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource ProcessTreeItem}" />
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Overlay                                                      -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.overlay}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.overlay}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr overlay.subtitle}"
                               Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />

                    <!-- Activación: siempre habilitada, incluso con el overlay apagado. -->
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <CheckBox Content="{l:Tr overlay.enable}"
                                      IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"
                                      FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr overlay.enableHint}"
                                       Style="{StaticResource MutedText}" Margin="28,7,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{l:Tr overlay.safeHint}"
                                       Style="{StaticResource MutedText}" Margin="28,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{l:Tr overlay.lockedHint}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="28,10,0,0" FontWeight="SemiBold"
                                       Visibility="{Binding OverlayLocked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- El resto queda bloqueado y atenuado mientras el overlay esté apagado. -->
                    <StackPanel IsEnabled="{Binding OverlaySettingsEnabled}" Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverlayLocked}" Value="True">
                                        <Setter Property="Opacity" Value="0.42" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Vista previa a todo el ancho: con muchas métricas la barra
                             es larga. Si aun así no entra, se achica en lugar de cortarse. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{l:Tr overlay.preview}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{l:Tr overlay.previewHint}"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,14"
                                           TextWrapping="Wrap" />
                                <Border CornerRadius="7" Padding="14" MinHeight="88">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#233A3D" Offset="0" />
                                            <GradientStop Color="#141B2A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <controls:OverlayBar Visibility="{Binding IsBarMode, Converter={StaticResource BoolToVis}}" />
                                            <controls:BenchmarkPanel Visibility="{Binding IsBenchmarkMode, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Viewbox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <controls:ResponsiveGrid MinItemWidth="400" MaxColumns="2" Gap="18">

                            <!-- Apariencia -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr overlay.appearance}" Style="{StaticResource SectionTitle}" />

                                    <!-- Modo: barra compacta o panel de benchmark con gráficos. -->
                                    <TextBlock Text="{l:Tr overlay.mode}" Style="{StaticResource SecondaryText}" Margin="0,10,0,6" />
                                    <Border Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Left"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{l:Tr overlay.modeBar}" Style="{StaticResource SegmentButton}" GroupName="OverlayMode"
                                                         IsChecked="{Binding IsBarMode, Mode=TwoWay}" />
                                            <RadioButton Content="{l:Tr overlay.modeBenchmark}" Style="{StaticResource SegmentButton}" GroupName="OverlayMode"
                                                         IsChecked="{Binding IsBenchmarkMode, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{l:Tr overlay.modeHint}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,6,0,4" />

                                    <!-- Estilo de colores: la primera elección. Con colores a
                                         medida activos queda atenuado porque no se aplica. -->
                                    <TextBlock Text="{l:Tr overlay.colorStyle}"
                                               Style="{StaticResource SecondaryText}" Margin="0,12,0,8" />
                                    <Grid IsEnabled="{Binding OverlayStylesEnabled}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OverlayCustomColors}" Value="True">
                                                        <Setter Property="Opacity" Value="0.42" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Style="{StaticResource OptionTile}" GroupName="OverlayStyle"
                                                     IsChecked="{Binding OverlayStyleMinimal, Mode=TwoWay}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Fill="#FFFFFFFF" Margin="0,0,4,0" />
                                                    <Ellipse Width="10" Height="10" Fill="#FFFFFFFF" Margin="0,0,4,0" />
                                                    <Ellipse Width="10" Height="10" Fill="#FFFFFFFF" />
                                                </StackPanel>
                                                <TextBlock Text="{l:Tr overlay.style.minimal}"
                                                           FontWeight="SemiBold" Margin="0,8,0,0" />
                                                <TextBlock Text="{l:Tr overlay.style.minimalHint}"
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton Grid.Column="2" Style="{StaticResource OptionTile}" GroupName="OverlayStyle"
                                                     IsChecked="{Binding OverlayStyleVaried, Mode=TwoWay}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Fill="#FFFFD166" Margin="0,0,4,0" />
                                                    <Ellipse Width="10" Height="10" Fill="#FF7BD88F" Margin="0,0,4,0" />
                                                    <Ellipse Width="10" Height="10" Fill="#FFC792EA" Margin="0,0,4,0" />
                                                    <Ellipse Width="10" Height="10" Fill="#FF56B6C2" />
                                                </StackPanel>
                                                <TextBlock Text="{l:Tr overlay.style.varied}"
                                                           FontWeight="SemiBold" Margin="0,8,0,0" />
                                                <TextBlock Text="{l:Tr overlay.style.variedHint}"
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <TextBlock Text="{l:Tr overlay.style.overridden}"
                                               Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding OverlayCustomColors, Converter={StaticResource BoolToVis}}" />

                                    <Grid Margin="0,16,0,0">
                                        <TextBlock Text="{l:Tr overlay.textSize}"
                                                   Style="{StaticResource SecondaryText}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding OverlayTextSizeText}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="10" Maximum="24"
                                            SmallChange="1" LargeChange="2"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding OverlayTextSize, Mode=TwoWay}"
                                            Margin="0,7,0,0" />

                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="{l:Tr overlay.backgroundOpacity}"
                                                   Style="{StaticResource SecondaryText}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding OverlayBackgroundOpacityText}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100"
                                            SmallChange="5" LargeChange="10"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding OverlayBackgroundOpacity, Mode=TwoWay}"
                                            Margin="0,7,0,0" />

                                    <CheckBox Content="{l:Tr overlay.squareCorners}"
                                              IsChecked="{Binding OverlaySquareCorners, Mode=TwoWay}"
                                              Margin="0,14,0,0" />
                                    <TextBlock Text="{l:Tr overlay.squareCornersHint}"
                                               Style="{StaticResource MutedText}" Margin="28,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Métricas y colores por grupo -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr overlay.metrics}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{l:Tr overlay.metricsHint}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                               TextWrapping="Wrap" />

                                    <ItemsControl ItemsSource="{Binding OverlayMetrics}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0,0,18,9" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </controls:ResponsiveGrid>

                        <!-- Colores a medida: apagados por defecto. Mientras estén
                             apagados, los controles quedan bloqueados y manda el estilo. -->
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <CheckBox Content="{l:Tr overlay.customColors}"
                                          IsChecked="{Binding OverlayCustomColors, Mode=TwoWay}"
                                          FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Tr overlay.customColorsHint}"
                                           Style="{StaticResource MutedText}" Margin="28,7,0,0"
                                           TextWrapping="Wrap" />

                                <StackPanel IsEnabled="{Binding OverlayCustomColors}" Margin="0,14,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverlayCustomColors}" Value="False">
                                                    <Setter Property="Opacity" Value="0.42" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Grid Margin="0,0,0,8" MaxWidth="560" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:Tr overlay.textColor}"
                                                   Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding OverlayColorOptions}"
                                                  ItemTemplate="{StaticResource OverlayColorTemplate}"
                                                  SelectedValuePath="Hex"
                                                  SelectedValue="{Binding OverlayTextColor, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Text="{l:Tr overlay.groupColorsHint}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,10"
                                               TextWrapping="Wrap" />

                                    <ItemsControl ItemsSource="{Binding OverlayGroupColors}"
                                                  MaxWidth="560" HorizontalAlignment="Left">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="160" />
                                                        <ColumnDefinition Width="200" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}"
                                                               Style="{StaticResource SecondaryText}"
                                                               VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding Options}"
                                                              ItemTemplate="{StaticResource OverlayColorTemplate}"
                                                              SelectedValuePath="Hex"
                                                              SelectedValue="{Binding SelectedHex, Mode=TwoWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Posición, atajo y alcance -->
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Tr overlay.position}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{l:Tr overlay.positionHint}"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />

                                <!-- Posiciones predefinidas: la barra queda anclada a ese lugar. -->
                                <TextBlock Text="{l:Tr overlay.presetPositions}"
                                           Style="{StaticResource SecondaryText}" Margin="0,12,0,8" />
                                <ItemsControl ItemsSource="{Binding OverlayAnchorOptions}"
                                              HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource SegmentButton}"
                                                         GroupName="OverlayAnchor"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         ToolTip="{Binding Label}"
                                                         Width="44" Height="34">
                                                <TextBlock Text="{Binding Glyph}" FontSize="15" />
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Tr overlay.presetPositionsHint}"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />

                                <!-- Bloqueado por defecto: la barra no recibe clics y no se
                                     puede tocar sin querer mientras se juega. -->
                                <CheckBox Content="{l:Tr overlay.lock}"
                                          IsChecked="{Binding OverlayPositionLocked, Mode=TwoWay}"
                                          FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock Text="{l:Tr overlay.lockHint}"
                                           Style="{StaticResource MutedText}" Margin="28,6,0,0"
                                           TextWrapping="Wrap" />

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{l:Tr overlay.resetPosition}"
                                            Command="{Binding ResetOverlayPositionCommand}"
                                            Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" />
                                    <Button Content="{l:Tr overlay.resetMetrics}"
                                            Command="{Binding ResetOverlayMetricsCommand}"
                                            Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>

                                <TextBlock Text="{l:Tr overlay.editingHint}"
                                           Style="{StaticResource SecondaryText}"
                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                           Visibility="{Binding IsOverlayEditing, Converter={StaticResource BoolToVis}}" />

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{l:Tr overlay.hotkey}" Style="{StaticResource SecondaryText}"
                                               VerticalAlignment="Center" />
                                    <TextBox HorizontalAlignment="Right" Width="150" IsReadOnly="True" Tag="toggle"
                                             Text="{Binding OverlayHotkeyText, Mode=OneWay}" Cursor="Hand"
                                             FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                             TextAlignment="Center" Padding="6,4" IsReadOnlyCaretVisible="False"
                                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             ToolTip="{l:Tr overlay.hotkeyEditHint}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{l:Tr overlay.hotkeyMode}" Style="{StaticResource SecondaryText}"
                                               VerticalAlignment="Center" />
                                    <TextBox HorizontalAlignment="Right" Width="150" IsReadOnly="True" Tag="mode"
                                             Text="{Binding OverlayModeHotkeyText, Mode=OneWay}" Cursor="Hand"
                                             FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                             TextAlignment="Center" Padding="6,4" IsReadOnlyCaretVisible="False"
                                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             ToolTip="{l:Tr overlay.hotkeyEditHint}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{l:Tr overlay.hotkeyRecord}" Style="{StaticResource SecondaryText}"
                                               VerticalAlignment="Center" />
                                    <TextBox HorizontalAlignment="Right" Width="150" IsReadOnly="True" Tag="record"
                                             Text="{Binding OverlayRecordHotkeyText, Mode=OneWay}" Cursor="Hand"
                                             FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                             TextAlignment="Center" Padding="6,4" IsReadOnlyCaretVisible="False"
                                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             ToolTip="{l:Tr overlay.hotkeyEditHint}" />
                                </Grid>
                                <TextBlock Text="{Binding HotkeyError}" Foreground="{StaticResource DangerBrush}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" />
                                <TextBlock Text="{l:Tr overlay.hotkeyHint}"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{l:Tr overlay.fullscreenHint}"
                                           Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Ajustes                                                      -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.settings}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.settings}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr settings.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <controls:ResponsiveGrid Margin="0,18,0,0" MinItemWidth="400" MaxColumns="2" Gap="18">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr settings.monitoring}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{l:Tr settings.readOnly}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,18" />

                                    <Grid>
                                        <TextBlock Text="{l:Tr settings.refresh}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding RefreshIntervalText}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="500" Maximum="10000"
                                            SmallChange="500" LargeChange="500"
                                            TickFrequency="500" IsSnapToTickEnabled="True"
                                            Value="{Binding RefreshIntervalMs, Mode=TwoWay}"
                                            Margin="0,7,0,0" />
                                    <TextBlock Text="{l:Tr settings.refreshHint}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:Tr settings.language}" Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Width="230" Height="30" MinWidth="0"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  ItemTemplate="{StaticResource LanguageNameTemplate}"
                                                  SelectedValuePath="Code"
                                                  SelectedValue="{Binding Language, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="{l:Tr settings.languageHint}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />

                                    <CheckBox Content="{l:Tr settings.runAtStartup}" Margin="0,18,0,0"
                                              IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.runAtStartupHint}"
                                               Style="{StaticResource MutedText}" Margin="28,4,0,0" />

                                    <CheckBox Content="{l:Tr settings.startMinimized}" Margin="0,16,0,0"
                                              IsChecked="{Binding StartMinimized, Mode=TwoWay}" />

                                    <CheckBox Content="{l:Tr settings.minimizeToTray}" Margin="0,16,0,0"
                                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.exitHint}"
                                               Style="{StaticResource MutedText}" Margin="28,4,0,0" />

                                    <!-- Widget de escritorio: opcional. -->
                                    <CheckBox Content="{l:Tr settings.widget}" Margin="0,16,0,0"
                                              IsChecked="{Binding ShowWidget, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.widgetHint}" TextWrapping="Wrap"
                                               Style="{StaticResource MutedText}" Margin="28,4,0,0" />
                                    <CheckBox Content="{l:Tr settings.widgetTopmost}" Margin="28,8,0,0"
                                              IsEnabled="{Binding ShowWidget}"
                                              IsChecked="{Binding WidgetTopmost, Mode=TwoWay}" />
                                    <!-- Temperatura en el ícono de la bandeja: opcional. -->
                                    <CheckBox Content="{l:Tr settings.trayTemperature}" Margin="0,16,0,0"
                                              IsChecked="{Binding TrayShowTemperature, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.trayTemperatureHint}" TextWrapping="Wrap"
                                               Style="{StaticResource MutedText}" Margin="28,4,0,0" />
                                    <Border Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Left"
                                            BorderBrush="{StaticResource BorderBrush}" Margin="28,8,0,0"
                                            BorderThickness="1" CornerRadius="9" Padding="2"
                                            IsEnabled="{Binding TrayShowTemperature}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="CPU" Style="{StaticResource SegmentButton}" GroupName="TrayTemp"
                                                         IsChecked="{Binding TrayTemperatureIsCpu, Mode=TwoWay}" />
                                            <RadioButton Content="GPU" Style="{StaticResource SegmentButton}" GroupName="TrayTemp"
                                                         IsChecked="{Binding TrayTemperatureIsGpu, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Separator Margin="0,18,0,14" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:Tr settings.saveNow}" Style="{StaticResource AccentButton}"
                                                Command="{Binding SaveNowCommand}" />
                                        <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{l:Tr settings.hardware}" Style="{StaticResource SectionTitle}" />
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Image Source="{Binding BoardLogoUri}" Height="14" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.85"
                                                   Visibility="{Binding HasBoardLogo, Converter={StaticResource BoolToVis}}" />
                                            <Border Style="{StaticResource BrandBadge}"
                                                    Visibility="{Binding HasBoardBrandText, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding BoardBrandText}" Style="{StaticResource BrandBadgeText}" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{l:Tr hw.cpu}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CpuName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="1" Text="{l:Tr hw.gpu}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="2" Text="{l:Tr hw.board}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MotherboardName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="3" Text="Super I/O" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SuperIoName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11" />

                                        <TextBlock Grid.Row="4" Text="{l:Tr settings.ram}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RamText}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RamText}" />

                                        <TextBlock Grid.Row="5" Text="{l:Tr settings.disks}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DisksText}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisksTooltip}" />

                                        <TextBlock Grid.Row="6" Text="Driver" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                   Text="{Binding DriverVersion, StringFormat={}PawnIO {0}}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11" />

                                        <TextBlock Grid.Row="7" Text="{l:Tr settings.admin}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AdminText}"
                                                   Style="{StaticResource SecondaryText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr settings.diagnostics}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{l:Tr settings.config}" Style="{StaticResource SecondaryText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding ConfigPath}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="{l:Tr settings.openConfig}" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding OpenConfigFolderCommand}" />
                                        <Button Content="{l:Tr settings.openLogs}" Style="{StaticResource SecondaryButton}"
                                                Margin="10,0,0,0"
                                                Command="{Binding OpenLogFolderCommand}" />
                                    </StackPanel>

                                    <CheckBox Content="{l:Tr settings.sendErrors}" Margin="0,18,0,0"
                                              IsChecked="{Binding SendErrorReports, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.sendErrorsHint}"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                               Margin="28,4,0,0" />

                                    <!-- Aviso de versión nueva: activado por defecto, se puede apagar. -->
                                    <CheckBox Content="{l:Tr settings.checkUpdates}" Margin="0,18,0,0"
                                              IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.checkUpdatesHint}"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                               Margin="28,4,0,0" />
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource AccentSoftBrush}"
                                            Margin="28,10,0,0" Padding="12,8" HorizontalAlignment="Left"
                                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource AccentTextBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Content="{l:Tr settings.downloadUpdate}" Style="{StaticResource AccentButton}"
                                                    Margin="12,0,0,0" Command="{Binding OpenUpdateCommand}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Feedback en GitHub: abre el formulario en el navegador. -->
                                    <TextBlock Text="{l:Tr settings.feedback}" Style="{StaticResource SecondaryText}"
                                               Margin="0,18,0,0" />
                                    <TextBlock Text="{l:Tr settings.feedbackHint}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="{l:Tr settings.reportBug}" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,10,0" Command="{Binding ReportBugCommand}" />
                                        <Button Content="{l:Tr settings.suggest}" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SuggestImprovementCommand}" />
                                    </WrapPanel>

                                    <Separator Margin="0,18,0,14" />

                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="Ctrl Monitor · WPF + LibreHardwareMonitor + PawnIO"
                                               Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    <TextBlock Text="{l:Tr settings.biosNote}"
                                               Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </controls:ResponsiveGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

    <!-- Pregunta única, la primera vez que se abre la app: ¿enviar informes de errores? -->
    <Grid Visibility="{Binding ShowErrorReportsPrompt, Converter={StaticResource BoolToVis}}">
        <Border Background="#B3060709" />
        <Border Style="{StaticResource Card}" MaxWidth="480" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22">
            <StackPanel>
                <TextBlock Text="{l:Tr errorReports.promptTitle}" Style="{StaticResource SectionTitle}"
                           FontSize="17" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr errorReports.promptBody}" Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="{l:Tr errorReports.promptNote}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{l:Tr errorReports.no}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AnswerErrorReportsCommand}" CommandParameter="no" />
                    <Button Content="{l:Tr errorReports.yes}" Style="{StaticResource AccentButton}"
                            Margin="10,0,0,0" IsDefault="True"
                            Command="{Binding AnswerErrorReportsCommand}" CommandParameter="yes" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
