<Window x:Class="CtrlMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CtrlMonitor.App.Controls"
        xmlns:l="clr-namespace:CtrlMonitor.App.Localization"
        Title="Ctrl Monitor"
        Width="1220" Height="820" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/fan.ico"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Plantillas explícitas en lugar de DisplayMemberPath: el estilo del
             ComboBox muestra la opción elegida con ItemTemplate, y así el texto
             también se actualiza al cambiar de idioma. -->
        <DataTemplate x:Key="MetricTitleTemplate">
            <TextBlock Text="{Binding Title}" />
        </DataTemplate>
        <DataTemplate x:Key="LanguageNameTemplate">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>

        <DataTemplate x:Key="ChartCardTemplate">
            <!-- Toda la tarjeta se puede arrastrar para reordenarla; el selector
                 y la ✕ manejan sus propios clics y no inician el arrastre. -->
            <Border Padding="16,14,14,10" Margin="5" MinHeight="190"
                    AllowDrop="True"
                    MouseLeftButtonDown="ChartCard_MouseLeftButtonDown"
                    MouseMove="ChartCard_MouseMove"
                    MouseLeftButtonUp="ChartCard_MouseLeftButtonUp"
                    LostMouseCapture="ChartCard_LostMouseCapture"
                    DragOver="ChartCard_DragOver"
                    Drop="ChartCard_Drop">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <!-- Clic sobre la tarjeta: se «levanta» con borde y sombra de acento. -->
                            <DataTrigger Binding="{Binding IsDragArmed}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3B82F6" BlurRadius="22"
                                                          ShadowDepth="0" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <!-- Durante el arrastre la tarjeta real marca el hueco donde
                                 va a caer; la copia flotante sigue al cursor. -->
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⠿" FontFamily="Segoe UI Symbol" FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="-4,0,6,0"
                                           Cursor="SizeAll"
                                           ToolTip="{l:Tr chart.dragTooltip}" />
                                <Ellipse Width="9" Height="9" Fill="{Binding Color}"
                                         VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding SelectedMetric, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource MetricTitleTemplate}"
                                          Width="110" Height="26" MinWidth="0" FontSize="11.5"
                                          Margin="9,0,0,0"
                                          ToolTip="{l:Tr chart.metricTooltip}" />
                                <Button Content="✕" Style="{StaticResource GhostButton}"
                                        Width="24" Height="24" Padding="0" FontSize="11"
                                        Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveChartPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{l:Tr chart.removeTooltip}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                       Margin="32,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SecondaryLabel}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SecondaryValue}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SecondaryValueBrush}" />
                                    <TextBlock Text="{Binding SecondaryUnit}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                            </StackPanel>

                            <Border Width="1" Height="34" Margin="0,0,12,0"
                                    Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrimaryLabel}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" Margin="0,0,0,2"
                                           Visibility="{Binding HasPrimaryLabel, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PrimaryValue}"
                                               FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding PrimaryUnit}" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,-2,0,0"
                                            Visibility="{Binding HasTertiary, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding TertiaryValue}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TertiaryUnit}" FontSize="9.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <controls:LiveChart Grid.Row="1" Margin="0,8,0,0"
                                        Samples="{Binding DataContext.ChartSamples, RelativeSource={RelativeSource AncestorType=Window}}"
                                        WindowMinutes="{Binding DataContext.ChartWindowMinutes, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Series="{Binding SeriesKey}"
                                        Unit="{Binding AxisUnit}"
                                        AxisMin="{Binding AxisMin}"
                                        AxisMax="{Binding AxisMax}"
                                        AxisStep="{Binding AxisStep}"
                                        AutoScale="True" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" TabStripPlacement="Left">

        <!-- ============================================================ -->
        <!-- Resumen                                                      -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.summary}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.summary}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr summary.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <controls:ResponsiveGrid Margin="0,22,0,0" MinItemWidth="205" MaxColumns="4" Gap="12"
                                            BalancedRows="True">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CpuIconGeometry}" Fill="{StaticResource AccentBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.cpuTemp}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding CpuTemperature, StringFormat={}{0:0}, TargetNullValue=—}" />
                                    <TextBlock Text="°C" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding CpuMaxTemperature, StringFormat={}Máx {0:0} °C, TargetNullValue=Máx —}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GpuIconGeometry}" Fill="{StaticResource AccentBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.gpuTemp}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding GpuTemperature, StringFormat={}{0:0}, TargetNullValue=—}" />
                                    <TextBlock Text="°C" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding GpuHotspot, StringFormat={}Hotspot {0:0} °C, TargetNullValue=Hotspot —}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CpuIconGeometry}" Fill="{StaticResource SuccessBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.cpuPower}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding CpuPower, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                    <TextBlock Text="W" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding CpuLoad, StringFormat={}Carga {0:0} %, TargetNullValue=Carga —}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}" Margin="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GpuIconGeometry}" Fill="{StaticResource SuccessBrush}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr summary.gpuPower}" Style="{StaticResource CaptionText}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding GpuPower, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                    <TextBlock Text="W" Style="{StaticResource UnitText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0"
                                           Text="{Binding GpuLoad, StringFormat={}Carga {0:0} %, TargetNullValue=Carga —}" />
                            </StackPanel>
                        </Border>
                    </controls:ResponsiveGrid>

                    <!-- CPU y GPU -->
                    <controls:ResponsiveGrid Margin="0,16,0,0" MinItemWidth="380" MaxColumns="2" Gap="16">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="2" Source="{Binding CpuLogoUri}" Height="18" Opacity="0.9"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasCpuLogo, Converter={StaticResource BoolToVis}}" />
                                    <Border Style="{StaticResource IconBadge}">
                                        <Path Data="{StaticResource CpuIconGeometry}" Fill="{StaticResource AccentBrush}"
                                              Width="21" Height="21" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:Tr hw.cpu}" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                    Background="{StaticResource AccentSoftBrush}" Padding="9,3">
                                                <TextBlock Text="CPU" Foreground="{StaticResource AccentHoverBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:Tr summary.temperature}" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SensorValueText}">
                                        <Run Text="{Binding CpuTemperature, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="1" Text="{l:Tr summary.coreMax}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding CpuMaxTemperature, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Text="{l:Tr summary.power}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding CpuPower, Mode=OneWay, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                        <Run Text=" W" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="3" Text="{l:Tr summary.fan}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding CpuFanRpm, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" RPM" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource SuccessSoftBrush}">
                                        <Path Data="{StaticResource GpuIconGeometry}" Fill="{StaticResource SuccessBrush}"
                                              Width="21" Height="21" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:Tr hw.gpu}" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                    Background="{StaticResource SuccessSoftBrush}" Padding="9,3">
                                                <TextBlock Text="GPU" Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:Tr summary.temperature}" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SensorValueText}">
                                        <Run Text="{Binding GpuTemperature, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="1" Text="Hotspot" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding GpuHotspot, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" °C" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Text="{l:Tr summary.power}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding GpuPower, Mode=OneWay, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                        <Run Text=" W" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="3" Text="{l:Tr summary.fan}" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0">
                                        <Run Text="{Binding GpuFanRpm, Mode=OneWay, StringFormat={}{0:0}, TargetNullValue=—}" />
                                        <Run Text=" RPM" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="4" Text="VRAM" Style="{StaticResource SecondaryText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SensorValueText}"
                                               Margin="0,8,0,0"
                                               Text="{Binding VramText}"
                                               ToolTip="{Binding VramText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </controls:ResponsiveGrid>

                    <!-- Sistema -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <controls:ResponsiveGrid MinItemWidth="230" MaxColumns="3" Gap="24">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconBadge}" Width="30" Height="30"
                                                Background="{StaticResource WarningSoftBrush}">
                                            <Path Data="{StaticResource BoardIconGeometry}"
                                                  Fill="{StaticResource WarningBrush}"
                                                  Width="18" Height="18" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{l:Tr summary.boardCaption}" Style="{StaticResource CaptionText}"
                                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Image Source="{Binding BoardLogoUri}" Height="14" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.85"
                                               Visibility="{Binding HasBoardLogo, Converter={StaticResource BoolToVis}}" />
                                        <Border Style="{StaticResource BrandBadge}"
                                                Visibility="{Binding HasBoardBrandText, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding BoardBrandText}" Style="{StaticResource BrandBadgeText}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="{Binding MotherboardName}" Style="{StaticResource SectionTitle}"
                                           Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SuperIoName}" Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{l:Tr summary.boardTemp}" Style="{StaticResource CaptionText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource BigValue}"
                                               Text="{Binding BoardTemperature, StringFormat={}{0:0.0}, TargetNullValue=—}" />
                                    <TextBlock Text="°C" Style="{StaticResource UnitText}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{l:Tr summary.status}" Style="{StaticResource CaptionText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold"
                                               Margin="8,0,0,0" Foreground="{Binding StatusBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </controls:ResponsiveGrid>
                    </Border>

                    <!-- Almacenamiento: espacio usado y libre de cada unidad -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}" Width="30" Height="30">
                                    <Path Data="{StaticResource DiskIconGeometry}"
                                          Fill="{StaticResource AccentBrush}"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{l:Tr storage.title}" Style="{StaticResource CaptionText}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{l:Tr storage.loading}" Margin="0,12,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVolumes}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Un bloque por disco físico: salud, temperatura y desgaste
                                 arriba, y sus unidades con el espacio debajo. -->
                            <ItemsControl ItemsSource="{Binding StorageDisks}" Margin="0,14,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveGrid MinItemWidth="260" MaxColumns="3" Gap="24" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TemperatureText}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{Binding TemperatureBrush}" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVis}}" />
                                                    <Border Style="{StaticResource Chip}" Padding="8,3"
                                                            ToolTip="{l:Tr storage.healthTooltip}"
                                                            Visibility="{Binding HasHealth, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding HealthBrush}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding HealthText}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding HealthBrush}" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Detalle en un renglón y vida siempre presente (vacía en
                                                 discos sin ese dato): así las unidades de todos los discos
                                                 empiezan a la misma altura. -->
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Detail}" />
                                            <TextBlock Text="{Binding LifeText}" Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0" TextWrapping="NoWrap" />

                                            <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,12,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Letter}" FontSize="13.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"
                                                                           Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <ProgressBar Style="{StaticResource MeterBar}" Minimum="0" Maximum="100"
                                                                         Value="{Binding UsedPercent, Mode=OneWay}"
                                                                         Foreground="{Binding BarBrush}" Margin="0,7,0,0" />
                                                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource SecondaryText}"
                                                                       Margin="0,6,0,0" />
                                                            <TextBlock Text="{Binding UsedText}" Style="{StaticResource MutedText}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Gráfico                                                      -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.chart}" Style="{StaticResource NavTabItem}">
            <ScrollViewer x:Name="ChartScroll" Margin="24,20,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ChartRoot"
                      MinHeight="{Binding ViewportHeight, ElementName=ChartScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr chart.title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{l:Tr chart.subtitle}"
                                   Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,12,0,0">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="1 min" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartWindow"
                                             IsChecked="{Binding ChartWindowMinutes, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                                <RadioButton Content="5 min" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartWindow"
                                             IsChecked="{Binding ChartWindowMinutes, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=5}" />
                                <RadioButton Content="10 min" Style="{StaticResource SegmentButton}"
                                             GroupName="ChartWindow"
                                             IsChecked="{Binding ChartWindowMinutes, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=10}" />
                            </StackPanel>
                        </Border>

                        <Button Content="{l:Tr chart.clear}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearChartCommand}" />

                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                    Visibility="{Binding HasAvailableChartMetrics, Converter={StaticResource BoolToVis}}">
                            <ComboBox Width="140" Height="34" MinWidth="0"
                                      ItemsSource="{Binding AvailableChartMetrics}"
                                      SelectedItem="{Binding NewChartMetric, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource MetricTitleTemplate}"
                                      ToolTip="{l:Tr chart.addTooltip}" />
                            <Button Content="{l:Tr chart.add}" Style="{StaticResource AccentButton}"
                                    Command="{Binding AddChartPanelCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Margin="0,14,0,0"
                           Text="{l:Tr chart.hint}"
                           Style="{StaticResource MutedText}" />

                <ItemsControl Grid.Row="2" Margin="-5,2,-5,-5"
                              ItemsSource="{Binding ChartPanels}"
                              ItemTemplate="{StaticResource ChartCardTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid>
                                <UniformGrid.Columns>
                                    <MultiBinding Converter="{StaticResource ChartColumns}">
                                        <Binding Path="ViewportWidth" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                        <Binding Path="ViewportHeight" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                    </MultiBinding>
                                </UniformGrid.Columns>
                            </UniformGrid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Grid.Row="2" Margin="0,40,0,0"
                           Text="{l:Tr chart.empty}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Visibility="{Binding IsChartPanelsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Ventiladores                                                 -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.fans}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FansRoot" Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.fans}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr fans.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/fan.png" Width="18" Height="18"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FanSummaryText}" Style="{StaticResource SecondaryText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="{l:Tr fans.onlyActive}" Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowOnlyActiveFans, Mode=TwoWay}"
                                      ToolTip="{l:Tr fans.onlyActiveTooltip}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding VisibleFans}" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource WidthToColumns}, ConverterParameter='760:1,1200:2,3'}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource IconBadge}" Width="34" Height="34"
                                                    Background="{StaticResource TrackBrush}">
                                                <Image Source="/Assets/fan.png" Width="19" Height="19" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ChannelText}"
                                                               Style="{StaticResource SectionTitle}" />
                                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="7,2"
                                                            Background="{StaticResource SurfaceBrush}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RpmText}" FontSize="23" FontWeight="SemiBold"
                                                           Foreground="{Binding RpmBrush}" />
                                                <TextBlock Text="RPM" Style="{StaticResource UnitText}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <TextBlock Text="{l:Tr fans.pwmByBios}"
                                                       Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding PwmText}" HorizontalAlignment="Right"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>
                                        <ProgressBar Style="{StaticResource MeterBar}" Minimum="0" Maximum="100"
                                                     Value="{Binding PwmPercent}" Margin="0,6,0,0"
                                                     Visibility="{Binding HasPwm, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{l:Tr fans.noPwm}"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPwm}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,10,0,0"
                            Visibility="{Binding ShowActiveFilterEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{l:Tr fans.noneSpinning}"
                                   Style="{StaticResource SecondaryText}" />
                    </Border>

                    <TextBlock Text="{l:Tr fans.noChannelsHint}"
                               Style="{StaticResource MutedText}" Margin="6,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Sensores                                                     -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.sensors}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.sensors}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr sensors.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Background="Transparent" BorderThickness="0" Padding="0"
                                                      HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                      FocusVisualStyle="{x:Null}"
                                                      ToolTip="{l:Tr sensors.toggleTooltip}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource IconBadge}" Width="32" Height="32">
                                                    <Path Width="19" Height="19" Stretch="Uniform">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource CpuIconGeometry}" />
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IconKey}" Value="Gpu">
                                                                        <Setter Property="Data" Value="{StaticResource GpuIconGeometry}" />
                                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKey}" Value="Board">
                                                                        <Setter Property="Data" Value="{StaticResource BoardIconGeometry}" />
                                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource CaptionText}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource MutedText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />

                                                <Path Grid.Column="3" Width="9" Height="6" Margin="12,0,0,0"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource TextMutedBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 1,1 L 5,5 L 9,1"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="180" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </ToggleButton>

                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,7,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource SecondaryText}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        HorizontalAlignment="Right" Margin="16,0,0,0">
                                                                <TextBlock Text="{Binding ValueText}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{Binding ValueBrush}" />
                                                                <TextBlock Text="{Binding UnitText}"
                                                                           Style="{StaticResource MutedText}"
                                                                           Margin="5,0,0,2" VerticalAlignment="Bottom" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource MeterBar}"
                                                                     Minimum="0" Maximum="100"
                                                                     Value="{Binding Percent}"
                                                                     Margin="0,5,0,0"
                                                                     Visibility="{Binding ShowsBar, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Discos                                                       -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.disks}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr disks.title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr disks.subtitle}" Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="{l:Tr disks.empty}" Margin="0,18,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiskDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding DiskDetails}" Margin="0,18,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- Encabezado: disco, modelo, estado y temperatura -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBadge}" Background="{Binding ConditionSoftBrush}">
                                                <Path Data="{StaticResource DiskIconGeometry}" Fill="{Binding ConditionBrush}"
                                                      Width="21" Height="21" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Text="{Binding Model}" Style="{StaticResource SecondaryText}"
                                                               Margin="10,0,0,0" VerticalAlignment="Bottom"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TemperatureText}" FontSize="19" FontWeight="SemiBold"
                                                           Foreground="{Binding TemperatureBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                                <Border Style="{StaticResource Chip}" Background="{Binding ConditionSoftBrush}"
                                                        Padding="11,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding ConditionBrush}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ConditionText}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding ConditionBrush}" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Motivos cuando el estado no es «Bueno» -->
                                        <Border Margin="0,14,0,0" Padding="12,9" CornerRadius="8"
                                                Background="{Binding ConditionSoftBrush}"
                                                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{l:Tr disks.issuesTitle}" Style="{StaticResource CaptionText}" />
                                                <ItemsControl ItemsSource="{Binding Issues}" Focusable="False" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource SecondaryText}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Datos S.M.A.R.T. principales -->
                                        <ItemsControl ItemsSource="{Binding Stats}" Margin="0,16,0,0" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:ResponsiveGrid MinItemWidth="180" MaxColumns="4" Gap="18" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="{Binding ValueBrush}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Espacio: un anillo por unidad con el % usado -->
                                        <StackPanel Margin="0,6,0,14"
                                                    Visibility="{Binding HasVolumes, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{l:Tr disks.space}" Style="{StaticResource CaptionText}" />
                                            <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,32,8">
                                                            <controls:DonutChart Width="84" Height="84" Thickness="11"
                                                                                 Value="{Binding UsedPercent}"
                                                                                 Fill="{Binding BarBrush}"
                                                                                 Track="{StaticResource TrackBrush}"
                                                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Letter}" FontSize="15" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"
                                                                               Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource SecondaryText}"
                                                                           Margin="0,6,0,0" />
                                                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource MutedText}"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Tabla completa de atributos, plegada -->
                                        <Expander Header="{Binding AttributesHeader}" Margin="0,4,0,0"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  Visibility="{Binding HasAttributes, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Margin="0,10,0,0">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{l:Tr disks.column.id}" Style="{StaticResource CaptionText}" />
                                                    <TextBlock Grid.Column="1" Text="{l:Tr disks.column.name}" Style="{StaticResource CaptionText}" />
                                                    <TextBlock Grid.Column="2" Text="{l:Tr disks.column.current}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{l:Tr disks.column.worst}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="{l:Tr disks.column.threshold}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="{l:Tr disks.column.raw}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Attributes}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="44" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="150" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource SecondaryText}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Current}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Worst}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="4" Text="{Binding Threshold}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="5" Text="{Binding Raw}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================================================ -->
        <!-- Ajustes                                                      -->
        <!-- ============================================================ -->
        <TabItem Header="{l:Tr nav.settings}" Style="{StaticResource NavTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{l:Tr nav.settings}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr settings.subtitle}"
                               Style="{StaticResource PageSubtitle}" />

                    <controls:ResponsiveGrid Margin="0,18,0,0" MinItemWidth="400" MaxColumns="2" Gap="18">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr settings.monitoring}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{l:Tr settings.readOnly}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,18" />

                                    <Grid>
                                        <TextBlock Text="{l:Tr settings.refresh}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding RefreshIntervalText}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="500" Maximum="10000"
                                            SmallChange="500" LargeChange="500"
                                            TickFrequency="500" IsSnapToTickEnabled="True"
                                            Value="{Binding RefreshIntervalMs, Mode=TwoWay}"
                                            Margin="0,7,0,0" />
                                    <TextBlock Text="{l:Tr settings.refreshHint}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:Tr settings.language}" Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Width="230" Height="30" MinWidth="0"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  ItemTemplate="{StaticResource LanguageNameTemplate}"
                                                  SelectedValuePath="Code"
                                                  SelectedValue="{Binding Language, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="{l:Tr settings.languageHint}"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />

                                    <CheckBox Content="{l:Tr settings.runAtStartup}" Margin="0,18,0,0"
                                              IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.runAtStartupHint}"
                                               Style="{StaticResource MutedText}" Margin="28,4,0,0" />

                                    <CheckBox Content="{l:Tr settings.startMinimized}" Margin="0,16,0,0"
                                              IsChecked="{Binding StartMinimized, Mode=TwoWay}" />

                                    <CheckBox Content="{l:Tr settings.minimizeToTray}" Margin="0,16,0,0"
                                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                                    <TextBlock Text="{l:Tr settings.exitHint}"
                                               Style="{StaticResource MutedText}" Margin="28,4,0,0" />

                                    <Separator Margin="0,18,0,14" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:Tr settings.saveNow}" Style="{StaticResource AccentButton}"
                                                Command="{Binding SaveNowCommand}" />
                                        <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{l:Tr settings.hardware}" Style="{StaticResource SectionTitle}" />
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Image Source="{Binding BoardLogoUri}" Height="14" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.85"
                                                   Visibility="{Binding HasBoardLogo, Converter={StaticResource BoolToVis}}" />
                                            <Border Style="{StaticResource BrandBadge}"
                                                    Visibility="{Binding HasBoardBrandText, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding BoardBrandText}" Style="{StaticResource BrandBadgeText}" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{l:Tr hw.cpu}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CpuName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="1" Text="{l:Tr hw.gpu}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="2" Text="{l:Tr hw.board}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MotherboardName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="3" Text="Super I/O" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SuperIoName}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11" />

                                        <TextBlock Grid.Row="4" Text="{l:Tr settings.ram}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RamText}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RamText}" />

                                        <TextBlock Grid.Row="5" Text="{l:Tr settings.disks}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DisksText}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisksTooltip}" />

                                        <TextBlock Grid.Row="6" Text="Driver" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                   Text="{Binding DriverVersion, StringFormat={}PawnIO {0}}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,11" />

                                        <TextBlock Grid.Row="7" Text="{l:Tr settings.admin}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AdminText}"
                                                   Style="{StaticResource SecondaryText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr settings.diagnostics}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{l:Tr settings.config}" Style="{StaticResource SecondaryText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding ConfigPath}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="{l:Tr settings.openConfig}" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding OpenConfigFolderCommand}" />
                                        <Button Content="{l:Tr settings.openLogs}" Style="{StaticResource SecondaryButton}"
                                                Margin="10,0,0,0"
                                                Command="{Binding OpenLogFolderCommand}" />
                                    </StackPanel>

                                    <Separator Margin="0,18,0,14" />

                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="Ctrl Monitor · WPF + LibreHardwareMonitor + PawnIO"
                                               Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    <TextBlock Text="{l:Tr settings.biosNote}"
                                               Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </controls:ResponsiveGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
