<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FanCtrl</AssemblyName>
    <RootNamespace>FanCtrl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fan.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.5.0</Version>
    <Product>FanCtrl Monitor</Product>
    <Description>Monitor de temperaturas, ventiladores, potencia y voltajes. Solo lectura.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FanCtrl.Core\FanCtrl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\fan.ico" />
    <Resource Include="Assets\fan.png" />
    <Resource Include="Assets\asus.png" />
  </ItemGroup>

</Project>
